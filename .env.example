# Optional settings for compose.yaml / compose.dev.yaml.
# Copy to .env only when overriding defaults. Never put provider API keys here.
MUWEAVE_PORT=8080
MUWEAVE_API_PORT=8000
MUWEAVE_DEV_PORT=5173
# Build with the optional CPU transcription dependencies (models are not downloaded).
MUWEAVE_TRANSCRIPTION=false
# Optional existing faster-whisper model parent directory on the host:
# MUWEAVE_MODELS_DIR=D:/models
# Optional HTTP proxy reachable from containers (leave unset for a direct connection).
# MUWEAVE_PROXY=http://host.docker.internal:7890
# Optional compatible cached image when Docker Hub is unavailable (Node >=22.12).
# MUWEAVE_NODE_IMAGE=node:22-alpine
